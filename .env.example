# Copy this file to `.env.local` and adjust. All vars are optional —
# with none set, the app runs entirely on bundled demo data.

# Master switch. Set to "true" to attempt live federal-data fetches.
# When off (default), no network calls are made.
VITE_USE_LIVE_DATA=false

# --- USAspending.gov (agency spend, monthly obligations, contract awards) ---
# Free, no API key, CORS-friendly — works directly from the browser.
# Override only if you proxy it.
# VITE_USASPENDING_BASE=https://api.usaspending.gov

# --- #pipeline duplicate suppression (api/govdash-webhook.ts) ---
# The webhook keeps a durable ledger of every opportunity it has posted so a
# GovDash re-fire does not create a second #pipeline post. Both vars are
# injected automatically when the Vercel KV / Upstash integration is attached to
# the project - set them by hand only for local testing.
#
# IMPORTANT: if these are missing the ledger cannot be written at all. The
# webhook logs "DEDUP DEGRADED" and falls back to scanning Slack history, which
# is weaker (it cannot see posts that were deleted during cleanup). Attach the
# KV integration in Vercel rather than relying on the fallback.
# KV_REST_API_URL=https://your-store.upstash.io
# KV_REST_API_TOKEN=your_upstash_rest_token

# Channel id for the Slack-history dedup fallback. Defaults to #pipeline
# (C0B59LQGJTY). Must be the channel ID, not the name.
# PIPELINE_CHANNEL_ID=C0B59LQGJTY

# The Slack-history fallback needs `channels:history` on the bot token, in
# addition to the `chat:write` the post itself uses.
# SLACK_BOT_TOKEN=xoxb-...

# --- SAM.gov Opportunities (Opportunities page) ---
# Get a free key at https://open.gsa.gov/api/get-opportunities-public-api/
#
# RECOMMENDED: use the bundled proxy (api/sam.ts + Vite dev middleware), which
# injects the key server-side and avoids SAM.gov's missing CORS headers. Put
# your key in SAM_API_KEY (NO "VITE_" prefix — this stays server-side and is
# never shipped to the browser). The client calls /api/sam by default.
SAM_API_KEY=your_sam_gov_key_here
# SAM_BASE=https://api.sam.gov

# Override the client-side proxy route if you host it elsewhere.
# VITE_SAM_PROXY=/api/sam

# DIRECT MODE (advanced, no proxy): set VITE_SAM_PROXY="" and provide a
# client-visible key. SAM.gov's lack of CORS means this usually fails in a
# browser; intended for a CORS-permitting gateway only.
# VITE_SAM_API_KEY=your_sam_gov_key_here
# VITE_SAM_BASE=https://api.sam.gov
