# Copy this file to `.env.local` and adjust. All vars are optional —
# with none set, the app runs entirely on bundled demo data.

# Master switch. Set to "true" to attempt live federal-data fetches.
# When off (default), no network calls are made.
VITE_USE_LIVE_DATA=false

# --- USAspending.gov (agency spend, monthly obligations, contract awards) ---
# Free, no API key, CORS-friendly — works directly from the browser.
# Override only if you proxy it.
# VITE_USASPENDING_BASE=https://api.usaspending.gov

# --- SAM.gov Opportunities (Opportunities page) ---
# Requires a free key from https://open.gsa.gov/api/get-opportunities-public-api/
# IMPORTANT: SAM.gov does not send CORS headers, so direct browser calls are
# usually blocked. For production, point VITE_SAM_BASE at a proxy you control
# that injects the api_key server-side.
# VITE_SAM_API_KEY=your_sam_gov_key_here
# VITE_SAM_BASE=https://api.sam.gov
